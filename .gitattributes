# Normalize all text files to LF, in the repository and in the working tree.
* text=auto eol=lf

# Windows-only scripts need CRLF to run correctly.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never touch line endings or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pfx binary
*.dll binary
*.exe binary
