# Production settings for the Chatex API, read by systemd (EnvironmentFile) and by chatex-activate.
# Install as /etc/chatex/chatex.env, owned root:root, mode 600. systemd syntax: KEY=value, no export,
# no quotes needed. '__' stands for ':' in configuration keys (Jwt__SigningKey = Jwt:SigningKey).

ConnectionStrings__Chatex=Host=localhost;Database=chatex;Username=chatex;Password=CHANGE_ME

Jwt__Issuer=https://chat.example.com
Jwt__Audience=https://chat.example.com
# At least 32 characters, for example: openssl rand -base64 48
Jwt__SigningKey=CHANGE_ME

Storage__RootPath=/var/lib/chatex/uploads

# Optional (defaults shown):
# Jwt__AccessTokenLifetime=00:15:00
# Jwt__RefreshTokenLifetime=30.00:00:00
# Attachments__MaxBytes=20971520
# Presence__OfflineGraceSeconds=5
